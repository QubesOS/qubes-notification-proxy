# The Qubes OS Project, https://www.qubes-os.org
# Maintainer: Frédéric Pierret (fepitre) <frederic@invisiblethingslab.com>

pkgname=qubes-notification-agent
pkgver=@VERSION@
pkgrel=@REL@
pkgdesc="Guest-side notification proxy for Qubes OS"
arch=("x86_64")
url="https://www.qubes-os.org/"
license=('GPL-3.0-or-later')
depends=(
    gcc-libs
    glibc
    qubes-vm-qrexec
)
makedepends=(
    cargo
    qubes-vm-utils
)
provides=(notification-daemon)
conflicts=(notification-daemon)
install=archlinux/PKGBUILD.install

_pkgnvr="${pkgname}-${pkgver}-${pkgrel}"
source=("${_pkgnvr}.tar.gz")
sha256sums=(SKIP)

prepare() {
    cd "${_pkgnvr}"
    export RUSTUP_TOOLCHAIN=stable
    mv archlinux/Cargo.lock ./
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "${_pkgnvr}"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo build --frozen --release
}

check() {
    cd "${_pkgnvr}"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo test --frozen
}

package() {
    cd "${_pkgnvr}"
    install -Dm0755 target/release/notification-proxy-client \
        "${pkgdir}/usr/bin/qubes-notification-proxy-client"
    install -Dm0644 src/qubes-notification-agent.service \
        "${pkgdir}/usr/lib/systemd/user/qubes-notification-agent.service"
    install -Dm0644 src/90-qubes-notification-agent.preset \
        "${pkgdir}/usr/lib/systemd/user-preset/90-qubes-notification-agent.preset"
}

